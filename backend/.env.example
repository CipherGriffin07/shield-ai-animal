# Copy this file to .env and fill in real values.
# Nothing here is loaded automatically until you create .env.

ENVIRONMENT=development

# --- Database ---
# Default: local SQLite file. For Postgres/MySQL later, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/shield
DATABASE_URL=sqlite:///./shield.db

# --- Auth / JWT ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Google Maps (Google Cloud Console: enable Geocoding, Directions, Places APIs) ---
GOOGLE_MAPS_API_KEY=

# --- Cloudinary (https://cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email / SMTP (for password reset + notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@shield-ai.app

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for all (development only)
CORS_ORIGINS=*
